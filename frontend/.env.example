VITE_API_BASE_URL=/api/v1
# Clerk (opcional). Crea una aplicación en https://dashboard.clerk.com y copia
# la Publishable Key. La Secret Key va solo en el backend (CLERK_SECRET_KEY).
VITE_CLERK_PUBLISHABLE_KEY=
# Versión vigente de términos. Debe coincidir con TERMS_VERSION del backend.
VITE_TERMS_VERSION=2026-10
# Horas del corte de cancelación del portal (debe coincidir con PORTAL_CANCEL_CUTOFF_HOURS).
VITE_PORTAL_CANCEL_CUTOFF_HOURS=24
