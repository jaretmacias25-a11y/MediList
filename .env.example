APP_ENV=development
APP_SERVICE_NAME=medilist-api
# Si se omite, se usa el hostname del equipo/contenedor.
# APP_INSTANCE_ID=medilist-api-1
HTTP_PORT=8080
# json obligatorio en producción para agregación de logs
LOG_FORMAT=json
# Archivo JSON que lee Promtail. Si se omite, solo se escribe en stdout.
LOG_FILE=logs/medilist.jsonl
LOG_FILE_MAX_MB=100
LOG_FILE_BACKUPS=5
DATABASE_URL=postgres://postgres:CAMBIAR_PASSWORD@localhost:5432/medilist?sslmode=disable
# Pool y límites de espera para alta concurrencia.
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=30000
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_ISSUER=medilist
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=168
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Retención de observabilidad. 0 deshabilita la purga de esa tabla.
RETENTION_INTERVAL_HOURS=24
ERROR_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# Cuentas de paciente. En desarrollo el correo se escribe en un buzón local.
# Para producción se debe implementar un proveedor real antes de usar outbox.
EMAIL_PROVIDER=outbox
EMAIL_FROM=MediList <no-reply@medilist.local>
EMAIL_OUTBOX_DIR=outbox/emails
EMAIL_LINK_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60
TERMS_VERSION=2026-10
MIN_EDAD_CUENTA=18

# Agenda y portal del paciente.
CLINIC_TIMEZONE=America/Guayaquil
PORTAL_MIN_NOTICE_HOURS=2
PORTAL_MAX_ADVANCE_DAYS=90
PORTAL_CANCEL_CUTOFF_HOURS=24
AUTO_CONFIRM_PORTAL_BOOKINGS=true
REFERRAL_VALID_DAYS=90
